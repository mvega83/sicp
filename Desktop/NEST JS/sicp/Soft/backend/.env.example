# Copia este archivo a ".env" y ajusta los valores según tu entorno.
# En desarrollo local, estos valores calzan con el docker-compose.yml incluido.

NODE_ENV=development
PUERTO_APP=3000

# URL del frontend, para configurar CORS (quién puede llamar a esta API)
URL_FRONTEND=http://localhost:5173

# Carpeta donde se guardan los archivos subidos (imágenes de proyectos, documentos
# adjuntos, etc.). Debe ser una ruta absoluta, fuera de backend/frontend — ajústala a
# tu propio equipo/servidor. Si se deja vacía, se usa por defecto una carpeta
# "archivos-subidos" hermana de backend/frontend.
CARPETA_ALMACENAMIENTO_ARCHIVOS=

# Almacenamiento de archivos por FTP (opcional): solo hace falta en un hosting con
# disco efímero (ej. Render), donde los archivos subidos no pueden vivir en el mismo
# disco del backend. Si FTP_HOST queda vacío, los archivos se guardan localmente
# (comportamiento de siempre, usado en desarrollo).
# Host de tu servidor FTP de cPanel (ej. ftp.tudominio.cl).
FTP_HOST=
FTP_USUARIO=
FTP_CLAVE=
# Carpeta remota (dentro de tu cuenta cPanel) donde se guardan los archivos, ej.
# "public_html/archivos-subidos" para que queden accesibles por HTTP.
FTP_RUTA_BASE=public_html/archivos-subidos
# URL pública desde la que se sirven esos archivos (debe apuntar a FTP_RUTA_BASE).
FTP_URL_PUBLICA=https://tudominio.cl/archivos-subidos
# La mayoría de los hostings cPanel exigen FTPS (TLS). Si el tuyo solo acepta FTP sin
# cifrar, cambia esto a "false".
FTP_SEGURO=true

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=sicp_usuario
DB_PASSWORD=sicp_clave
DB_NAME=sicp

# Autenticación (JWT propio, usado tanto por el login de desarrollo como por OAuth)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Duración del token en segundos. 28800 = 8 horas.
JWT_EXPIRACION_SEGUNDOS=28800

# OAuth Google — opcional por ahora. Si se dejan vacías, el login de Google queda
# desactivado automáticamente (el backend arranca igual, sin errores).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth Microsoft — opcional por ahora. Si se dejan vacías, el login de Microsoft queda
# desactivado automáticamente (el backend arranca igual, sin errores).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
